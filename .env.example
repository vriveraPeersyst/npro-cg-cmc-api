# Environment Variables
# Copy this file to .env.local for local development.
# Every variable below is OPTIONAL: lib/env.ts reads each with a safe default,
# so the app boots with none of them set.

# Override the NEAR RPC URL. When unset, the RPC manager uses its built-in endpoint list.
# NEAR_RPC_URL=https://rpc.mainnet.near.org

# pino log level (trace|debug|info|warn|error|fatal). Defaults to "info".
# LOG_LEVEL=info

# TTL for the on-chain supply cache, in milliseconds. Defaults to 30000.
# SUPPLY_CACHE_TTL_MS=30000

# TTL for the price cache, in milliseconds. Defaults to 60000.
# PRICE_CACHE_TTL_MS=60000

# Note: Railway injects PORT at runtime and Next reads it natively — do not set it here.
